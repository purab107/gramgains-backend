{
  "name": "gramgains-backend",
  "version": "1.0.0",
  "description": "GramGains Calorie Tracker Backend - Monolithic Module Architecture",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "import:off": "node prisma/openfoodfacts-import.js",
    "audit:food": "node scripts/audit-food-database.js",
    "audit:food:strict": "node scripts/audit-food-database.js --strict",
    "test:audit": "node --test test/audit.test.js",
    "test:search": "node --test test/food-search.test.js",
    "benchmark:search": "node scripts/benchmark-search.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
