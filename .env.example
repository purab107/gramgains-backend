# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gramgains?schema=public"

# Supabase / pooled connections (optional - needed for Prisma in serverless environments)
# DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Authentication
BETTER_AUTH_SECRET="your-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:5000"

# CORS - set to your frontend origin
# In production, set this to your Vercel domain (e.g., https://gramgains.vercel.app)
FRONTEND_URL="http://localhost:3000"

# Cloudinary (Meal Image Uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
