enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum Goal {
  WEIGHT_LOSS
  MAINTAIN
  BULK
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  age           Int
  gender        Gender
  heightCm      Float
  activityLevel ActivityLevel @default(MODERATE)
  goal          Goal          @default(MAINTAIN)
  timezone      String        @default("UTC")

  bmr            Float
  tdee           Float
  targetCalories Float
  targetProtein  Float
  targetCarbs    Float
  targetFat      Float
  targetFiber    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoalHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal           Goal
  targetCalories Float
  targetProtein  Float
  targetCarbs    Float
  targetFat      Float
  targetFiber    Float

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([userId, effectiveFrom])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}
